 <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Muted" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#91A3B9"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#203149"/>
   <Setter Property="Foreground" Value="#E6EDF5"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#132338"/>
   <Setter Property="Background" Value="#E6EDF5"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#BECBDC"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="MatchStatus" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
  <Setter Property="Foreground" Value="#69DFC1"/>
  <Style.Triggers><DataTrigger Binding="{Binding HasMismatch}" Value="True">
   <Setter Property="Foreground" Value="Salmon"/>
  </DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="EngineStatus" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
  <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True">
   <Setter Property="Foreground" Value="Salmon"/>
  </DataTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
