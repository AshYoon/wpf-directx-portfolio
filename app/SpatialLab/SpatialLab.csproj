<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SpatialLab</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
    <Compile Include="../../tests/SpatialLab.SmokeTests/WpfSmokeTests.cs" Link="Diagnostics/WpfSmokeTests.cs"/>
    <None Include="../../out/build/windows-x64/bin/$(Configuration)/SceneRenderer.dll"
          Link="SceneRenderer.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckNativeRenderer" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../out/build/windows-x64/bin/$(Configuration)/SceneRenderer.dll')"
           Text="Build the native renderer first: scripts/build.ps1" />
  </Target>
</Project>
